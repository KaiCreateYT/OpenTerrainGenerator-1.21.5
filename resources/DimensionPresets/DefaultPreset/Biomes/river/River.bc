# |                              Blocks                             | #
# +-----------------------------------------------------------------+ #
#######################################################################

StoneBlock: minecraft:stone
SurfaceBlock: minecraft:grass_block
GroundBlock: minecraft:dirt
UnderWaterSurfaceBlock: minecraft:dirt
SurfaceAndGroundControl:
ReplacedBlocks:
#######################################################################
# +-----------------------------------------------------------------+ #
# |                   Water / Lava & Frozen States                  | #
# +-----------------------------------------------------------------+ #
#######################################################################

UseWorldWaterLevel: true
WaterLevelMax: 63
WaterLevelMin: 0
WaterBlock: minecraft:water
IceBlock: minecraft:ice
PackedIceBlock: minecraft:packed_ice
SnowBlock: minecraft:snow_block
CooledLavaBlock: minecraft:lava
#######################################################################
# +-----------------------------------------------------------------+ #
# |                       Visuals and weather                       | #
# +-----------------------------------------------------------------+ #
#######################################################################

BiomeTemperature: 0.5
UseFrozenOceanTemperature: false
BiomeWetness: 0.5
SkyColor: 0x7ba4ff
WaterColor: 0x0E4B8C
WaterColorControl:
GrassColor: 0xFFFFFF
GrassColorControl:
GrassColorModifier: None
FoliageColor: 0xFFFFFF
FoliageColorControl:
FogColor: 0xC0D8FF
FogDensity: 0.0
WaterFogColor: 0x050533
